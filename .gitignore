node_modules/
# also match a node_modules SYMLINK: the trailing-slash form above does not,
# which is how a self-referential symlink got committed and broke `npm ci`.
node_modules
*.log
.DS_Store

# Build output — regenerated by `npm run build:tokens` and the react build
# (the publish workflow rebuilds these in CI before `npm publish`).
dist/
react/dist/
*.tsbuildinfo

# design-sync machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
react/.ds-css-build/

# Local direnv bootstrap — machine-specific (matches aios-website / aios-team-brain,
# which both ignore it). It calls Tessera root helpers that only exist on a dev box.
.envrc

# npm pack output — build artifacts, never source.
*.tgz

# Coverage report — regenerated by `npm run test:coverage`. scan-on-merge.yml
# produces it on the runner and the brain reads coverage/lcov.info from there;
# a committed copy would go stale and report a number nobody measured.
coverage/
